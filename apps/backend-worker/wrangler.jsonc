{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chocosuke",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  // One origin: the frontend build is served as static assets at `/`, the API at `/api`.
  // `deploy` and `vp run -t backend-worker#build` build the frontend first.
  "assets": {
    "directory": "../frontend/dist",
    // Unknown paths fall back to index.html so vue-router's history mode works on reload.
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer unknown `/api/*` paths with index.html.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chocosuke",
      // Placeholder until `wrangler d1 create chocosuke`; local dev and tests don't need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "chocosuke-images" }],
  "triggers": {
    // Every minute: event notifications. 18:00 UTC (03:00 JST): purge of logically deleted data.
    "crons": ["* * * * *", "0 18 * * *"],
  },
  // No `vars`: environment-specific values are secrets (`wrangler secret put`, `.dev.vars` locally)
  // so the public repository holds none (root AGENTS.md "Public config values for the frontend").
  // Required: SESSION_SECRET. Optional (the feature is off while unset): GOOGLE_CLIENT_ID (the
  // `aud` accepted for Google ID tokens), VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
  "observability": {
    "enabled": true,
  },
}
